{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "NOVA",
    "mainBinaryName":  "NOVA",
    "version":  "1.0.0",
    "identifier":  "com.ahmed.nova.desktop",
    "build":  {
                  "frontendDist":  "../../web"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "NOVA",
                                    "width":  1280,
                                    "height":  800,
                                    "minWidth":  940,
                                    "minHeight":  620,
                                    "resizable":  true,
                                    "decorations":  false,
                                    "transparent":  true,
                                    "shadow":  false,
                                    "center":  true,
                                    "visible":  true,
                                    "dragDropEnabled":  false,
                                    "useHttpsScheme":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "publisher":  "Ahmed",
                   "category":  "Productivity",
                   "shortDescription":  "NOVA desktop control center",
                   "longDescription":  "NOVA Desktop â€” the standalone control center for the NOVA voice AI agent: live system stats, Spotify, Obsidian vault, weather, and agent activity.",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "currentUser"
                                            }
                               }
               },
    "plugins":  {

                }
}