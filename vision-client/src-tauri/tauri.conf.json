{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA Vision",
  "version": "0.1.0",
  "identifier": "ai.nova.vision",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1428",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NOVA Vision",
        "width": 420,
        "height": 560,
        "minWidth": 380,
        "minHeight": 150,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://127.0.0.1:1428; connect-src 'self' ipc: http://ipc.localhost ws: wss: https:; media-src 'self' blob: mediastream:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
