# ============================================================
# NOVA EXAMPLE ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and add your private values.
# Never place real API keys in this example file.
# ============================================================


# ------------------------------------------------------------
# LIVEKIT
# ------------------------------------------------------------

LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret


# ------------------------------------------------------------
# GEMINI LIVE
# ------------------------------------------------------------

GOOGLE_API_KEY=your_google_api_key

NOVA_REALTIME_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
NOVA_VOICE=Puck
NOVA_TEMPERATURE=0.5


# ------------------------------------------------------------
# OPENAI SPECIALIST PROVIDER
# ------------------------------------------------------------

OPENAI_API_KEY=your_openai_api_key

NOVA_ENABLE_OPENAI=false
NOVA_OPENAI_MODEL=gpt-5.6


# ------------------------------------------------------------
# GROQ OPTIONAL PROVIDER
# ------------------------------------------------------------

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

NOVA_ENABLE_GROQ=false


# ------------------------------------------------------------
# LOCAL OLLAMA TEXT PROVIDER
# ------------------------------------------------------------

NOVA_ENABLE_OLLAMA=true
NOVA_OLLAMA_MODEL=llama3.2:latest
NOVA_OLLAMA_BASE_URL=http://localhost:11434


# ------------------------------------------------------------
# PROVIDER ROUTING
# ------------------------------------------------------------

# Available profiles:
# local
# cloud
# hybrid

NOVA_PROFILE=hybrid
NOVA_FALLBACK_ENABLED=true


# ------------------------------------------------------------
# CLOUD-USAGE PROTECTION
# ------------------------------------------------------------

NOVA_CLOUD_BUDGET_ENABLED=true

# Example safe public default.
NOVA_CLOUD_DAILY_REQUEST_LIMIT=5


# ------------------------------------------------------------
# NOVA GUARDIAN
# ------------------------------------------------------------

# Guardian should remain disabled by default for GitHub users.
NOVA_GUARDIAN_ENABLED=false

NOVA_SECURITY_MONITOR_ENABLED=true
NOVA_WINDOW_MONITOR_ENABLED=true

# Guardian reports suspicious activity but does not automatically
# kill processes, delete files, or change system settings.
NOVA_GUARDIAN_AUTO_RESPONSE=false

# How often Guardian performs lightweight security checks.
NOVA_SECURITY_SCAN_INTERVAL_SECONDS=15


# ------------------------------------------------------------
# LOCAL AMBIENT VISION
# ------------------------------------------------------------

# Available modes:
# off
# on_demand
# ambient
# temporary_session

# Safe public default.
NOVA_VISION_MODE=off

NOVA_LOCAL_VISION_ONLY=true
NOVA_PAUSE_ON_SENSITIVE_WINDOWS=true

# Your vision-capable Ollama model.
NOVA_LOCAL_VISION_MODEL=gemma3:4b

# Give slower laptops enough time to answer.
NOVA_LOCAL_VISION_TIMEOUT_SECONDS=240

# Reduce image size for 16 GB laptops.
NOVA_LOCAL_VISION_MAX_DIMENSION=512

# Keep answers brief.
NOVA_LOCAL_VISION_MAX_OUTPUT_TOKENS=100
NOVA_LOCAL_VISION_CONTEXT_SIZE=2048

# Keep the model loaded after a request.
NOVA_LOCAL_VISION_KEEP_ALIVE=10m

# Analyze at most once every 30 seconds during ambient mode.
NOVA_VISION_CAPTURE_INTERVAL_SECONDS=30

# Skip processing when the screen barely changed.
NOVA_VISION_CHANGE_THRESHOLD=8

# Temporary sessions expire after this many minutes.
NOVA_MAX_VISION_SESSION_MINUTES=5

# Screenshots are not stored.
NOVA_STORE_VISION_SCREENSHOTS=false
NOVA_SCREENSHOT_RETENTION_SECONDS=0


# ------------------------------------------------------------
# VISION PRIVACY EXCLUSIONS
# ------------------------------------------------------------

NOVA_VISION_EXCLUDED_PROCESSES=1password,bitwarden,keepass,keepassxc,lastpass,nordpass,protonpass,credentialui,logonui

NOVA_SENSITIVE_WINDOW_KEYWORDS=password,passcode,sign in,login,authentication,verification code,security code,one-time code,payment,checkout,banking,credit card,private browsing,incognito,api key,secret key,access token,credentials


# ------------------------------------------------------------
# SPOTIFY OPTIONAL INTEGRATION
# ------------------------------------------------------------

SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback


# ------------------------------------------------------------
# OBSIDIAN
# ------------------------------------------------------------

OBSIDIAN_VAULT_PATH=C:/path/to/your/Obsidian/Vault

# Not currently read by any code (informational only).
OBSIDIAN_VAULT_NAME=your_vault_display_name


# ------------------------------------------------------------
# LOCAL OLLAMA (bare names — actually read by tools/models.py and
# nova_core/configuration.py; kept alongside the NOVA_OLLAMA_* names
# above for the guardian module until the naming is reconciled,
# see docs/audit/2026-07-22/ENVIRONMENT_VARIABLES.md)
# ------------------------------------------------------------

OLLAMA_MODEL=mistral:latest
OLLAMA_BASE_URL=http://localhost:11434/v1


# ------------------------------------------------------------
# ------------------------------------------------------------


# wttr.in city lookup; leave blank to use IP-based geolocation.
NOVA_CITY=


# ------------------------------------------------------------
# EMAIL / CALENDAR INTEGRATIONS (nova_integrations)
# ------------------------------------------------------------

# Path to the real nova_integrations JSON config (see
# config/nova_integrations.example.json for the schema). Defaults to
# %LOCALAPPDATA%\NOVA\integrations\config.json when unset.
NOVA_INTEGRATIONS_CONFIG=

# Conversation privacy (opt-in only)
NOVA_SAVE_TRANSCRIPTS=false
NOVA_MIRROR_TRANSCRIPTS_TO_OBSIDIAN=false
