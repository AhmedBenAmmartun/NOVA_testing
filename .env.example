LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5.6
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_TIMEOUT_SECONDS=60

GOOGLE_API_KEY=replace_me
GROQ_API_KEY=replace_me
GROQ_MODEL=llama-3.3-70b-versatile

SPOTIFY_CLIENT_ID=replace_me
SPOTIFY_CLIENT_SECRET=replace_me
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

NOVA_REALTIME_MODEL=replace_with_current_model
NOVA_VOICE=Puck
NOVA_TEMPERATURE=0.5

# Absolute path to your Obsidian vault (used by the search_memory tool)
OBSIDIAN_VAULT_PATH=C:\path\to\your\ObsidianVault
